{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "family-spark",
	"main": "worker.ts",
	"workers_dev": true,
	"preview_urls": true,
	"compatibility_date": "2026-05-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_ROOMS",
				"class_name": "ChatRoomDurableObject"
			},
			{
				"name": "FAMILY_ACCOUNTS",
				"class_name": "FamilyAccountDurableObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ChatRoomDurableObject"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["FamilyAccountDurableObject"]
		}
	]
}
